{
    "features": {
        "roundabout": {
            "customData": {
                "raConfig": {
                    "propagate": [
                        "items",
                        "disabled",
                        "duration",
                        "idx",
                        "item",
                        "timeTicker",
                        "name",
                        "value"
                    ],
                    "compacts": {
                        "on_tick_of_timeTicker_inc_idx_by": 1,
                        "when_item_changes_dispatch": "value-changed"
                    },
                    "merges": [
                        {
                            "ifKeyIn": [
                                "duration"
                            ],
                            "assign": {
                                "?.timeTicker?.duration": "?.duration"
                            }
                        },
                        {
                            "ifKeyIn": [
                                "disabled"
                            ],
                            "assign": {
                                "?.timeTicker?.disabled": "?.disabled"
                            }
                        }
                    ],
                    "yields": {
                        "item": {
                            "from": "items",
                            "atIndex": "idx",
                            "outOfBounds": "clamp"
                        }
                    }
                }
            },
            "withAttrs": {
                "items": "items",
                "_items": {
                    "instanceOf": "Array"
                },
                "duration": "duration",
                "_duration": {
                    "instanceOf": "Number"
                },
                "name": "name",
                "_name": {
                    "sourceOfTruth": true,
                    "valIfNull": ""
                },
                "disabled": "disabled",
                "_disabled": {
                    "sourceOfTruth": true
                }
            }
        }
    }
}
